pipeline {
  agent {
    label 'wsl-linux'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    REGISTRY = "ghcr.io/pushpendra2601"
    BACKEND_IMAGE = "cloudcart-backend"
    FRONTEND_IMAGE = "cloudcart-frontend"
    NAMESPACE = "cloudcart"
    GITOPS_VALUES_FILE = "helm/cloudcart/values-gitops.yaml"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()}"
        }
      }
    }

    stage('Backend Tests') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD/app/backend:/app" \
            -w /app \
            node:22-alpine \
            sh -c "npm ci && npm test"
        '''
      }
    }

    stage('Build Images') {
      steps {
        sh '''
          docker build -t $REGISTRY/$BACKEND_IMAGE:$IMAGE_TAG app/backend
          docker build -t $REGISTRY/$FRONTEND_IMAGE:$IMAGE_TAG app/frontend
        '''
      }
    }

    stage('Security Scan') {
      steps {
        sh '''
          trivy image --severity HIGH,CRITICAL --exit-code 1 $REGISTRY/$BACKEND_IMAGE:$IMAGE_TAG
          trivy image --severity HIGH,CRITICAL --exit-code 1 $REGISTRY/$FRONTEND_IMAGE:$IMAGE_TAG
        '''
      }
    }

    stage('Push Images') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
          sh '''
            echo $PASS | docker login ghcr.io -u $USER --password-stdin
            docker push $REGISTRY/$BACKEND_IMAGE:$IMAGE_TAG
            docker push $REGISTRY/$FRONTEND_IMAGE:$IMAGE_TAG
          '''
        }
      }
    }

    stage('Update GitOps Image Tag') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
          sh '''
            git config user.name "cloudcart-jenkins"
            git config user.email "jenkins@cloudcart.local"

            sed -i "s|tag: .*|tag: \\"$IMAGE_TAG\\"|g" "$GITOPS_VALUES_FILE"

            git add "$GITOPS_VALUES_FILE"
            git commit -m "Update CloudCart image tag to $IMAGE_TAG" || exit 0

            git push https://$GIT_USER:$GIT_TOKEN@github.com/Pushpendra2601/CloudCart-Ecomm.git HEAD:main
          '''
        }
      }
    }
  }

  post {
    failure {
      script {
        try {
          sh '''
            echo "Deployment failed. Showing diagnostics..."
            kubectl get pods -n $NAMESPACE || true
            kubectl describe pods -n $NAMESPACE || true
          '''
        } catch (ignored) {
          echo "Deployment diagnostics skipped because no Linux workspace was available."
        }
      }
    }
  }
}
